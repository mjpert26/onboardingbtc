# Base URL of the n8n instance (no trailing slash). The public REST API lives under /api/v1.
N8N_BASE_URL=https://api.bigthinkcapital.com

# n8n public API key (Settings -> API in n8n). Must have permission to read executions.
N8N_API_KEY=

# The New Hire Onboarding workflow ID.
N8N_WORKFLOW_ID=VACEvv12ZYIaAzZi

# Set to "true" to force the built-in sample data even when an API key is present.
# When no API key is set, mock data is used automatically.
USE_MOCK=false
