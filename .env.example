# Base URL of the n8n instance (no trailing slash). The public REST API lives under /api/v1.
N8N_BASE_URL=https://api.bigthinkcapital.com

# n8n public API key (Settings -> API in n8n). Must have permission to read executions.
N8N_API_KEY=

# The New Hire Onboarding workflow ID.
N8N_WORKFLOW_ID=VACEvv12ZYIaAzZi

# Set to "true" to force the built-in sample data even when an API key is present.
# When no API key is set, mock data is used automatically.
USE_MOCK=false

# ---------------------------------------------------------------------------
# Microsoft Entra ID (Azure AD) SSO
# ---------------------------------------------------------------------------
# From the App Registration in Entra ID.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# Big Think Capital tenant ID.
AZURE_AD_TENANT_ID=91e22286-3995-43b2-9197-481a21962994

# Random secret used to encrypt the session cookie. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# The full base URL of the deployment (no trailing slash).
# Local: http://localhost:3000   Vercel: https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000

# Optional: override the built-in allowlist (comma-separated emails).
# Leave blank to use the 5 approved staff hard-coded in lib/auth.ts.
ALLOWED_EMAILS=
